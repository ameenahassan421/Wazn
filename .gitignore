node_modules
dist
dev-dist
.env
.env.local
.env.*.local
.DS_Store
*.log
.vercel

# Font cache for scripts/build_logo.py. The outlines it produces are
# committed; the font itself is fetched on demand and never shipped.
scripts/.aref-ruqaa-700.ttf

# Output of `npm run shots` and `npm run perf`. The screenshots are for
# looking at during a session, not for reviewing in a diff; the latency JSON
# is a machine-specific measurement, and the numbers that matter are quoted
# in the PR body and in DECISIONS.md.
shots
perf

# Impeccable: per-developer hook consent and machine-local Claude settings.
.impeccable/config.local.json
.claude/settings.local.json

# Playwright: run output, never source. `test-results/` holds screenshots and
# traces from failures, `playwright-report/` the HTML report.
test-results
playwright-report

# `npm run check:deploy` builds two copies of the app here to play a deploy
# out against a running page. It cleans up after itself; this covers the run
# that was interrupted.
.deploy-check
