# Client (safe to expose — protected by row level security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Import script only. NEVER prefix these with VITE_ and never commit real values:
# the service-role key bypasses row level security.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: the auth user id the import writes to. Can also be passed as
# `npm run import:hevy -- --user <uuid>`.
# IMPORT_USER_ID=00000000-0000-0000-0000-000000000000

# --- Optional: lets `npm run supabase:admin` configure the project ---
# Personal access token from https://supabase.com/dashboard/account/tokens.
# Org-wide: it can modify every project on the account. Never commit it.
# SUPABASE_ACCESS_TOKEN=sbp_...
# SUPABASE_PROJECT_REF=ttasiwxeqerhsztxjxip

# SMTP for auth emails. Supabase will not let you edit email templates until
# custom SMTP is set, and the built-in sender is rate limited to a few per hour.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_USER=resend
# SMTP_PASS=re_...
# SMTP_SENDER=onboarding@resend.dev
# SMTP_SENDER_NAME=Workout
