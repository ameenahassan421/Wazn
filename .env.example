# Client (safe to expose — protected by row level security)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Import script only. NEVER prefix these with VITE_ and never commit real values:
# the service-role key bypasses row level security.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: the auth user id the import writes to. Can also be passed as
# `npm run import:hevy -- --user <uuid>`.
# IMPORT_USER_ID=00000000-0000-0000-0000-000000000000
